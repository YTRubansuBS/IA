# Gemini
IA=your_gemini_api_key

# Supabase
URL=https://your-project.supabase.co
KEY=your_supabase_server_secret_key

# Roblox Open Cloud Analytics
# The shared key works for all configured universes.
# Alternatively use ROBLOX_API_KEY_<UNIVERSE_ID> for a different key per universe.
ROBLOX_API_KEY=your_roblox_open_cloud_api_key
# ROBLOX_API_KEY_1234567890=your_other_roblox_open_cloud_api_key
